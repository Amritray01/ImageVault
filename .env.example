# ImageVault Environment Configuration

APP_NAME=ImageVault
APP_VERSION=1.0.0
DEBUG=false

# Storage Backend: "s3" (AWS S3) or "local" (Local development)
STORAGE_BACKEND=s3
AWS_REGION=us-east-1
S3_BUCKET_NAME=imagevault-prod-storage

# If using IAM EC2 Instance Profile (ImgVaultEC2Role), LEAVE THESE BLANK:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./imagevault.db
# PostgreSQL for Production / Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/imagevault

# Image Processing Defaults
DEFAULT_JPEG_QUALITY=80
ENABLE_PROGRESSIVE_JPEG=true
MAX_IMAGE_DIMENSION=2560
MAX_UPLOAD_SIZE_MB=50
PHASH_SIMILARITY_THRESHOLD=6
